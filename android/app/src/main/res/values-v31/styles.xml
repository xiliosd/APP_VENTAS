<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ con el modo oscuro del sistema off: solo el color de fondo del
         inicio de marca, sin el ícono del sistema. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fondo_inicio</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/icono_transparente</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
